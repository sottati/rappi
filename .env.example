# PostgreSQL (Supabase)
MOCK_DB=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DATABASE=rappi

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Cassandra (DataStax Astra DB)
ASTRA_DB_SECURE_CONNECT_BUNDLE=/absolute/path/to/secure-connect-rappi.zip
ASTRA_DB_CLIENT_ID=your-client-id
ASTRA_DB_CLIENT_SECRET=your-client-secret
ASTRA_DB_KEYSPACE=rappi

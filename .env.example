# Auth interna de la app (cookie firmada)
AUTH_SECRET=genera-un-secreto-largo-para-firmar-sesiones

# UI: pins de motor de datos en cards (requiere reiniciar dev server)
NEXT_PUBLIC_SHOW_DATA_SOURCES=false

# PostgreSQL (Supabase)
# Usar mocks solo si se pide explicitamente. Para la entrega/demo real: false.
MOCK_DB=false
SUPABASE_DB_PASSWORD=your-password
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_ANON_KEY=your-legacy-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-server-only
# Transaction pooler (IPv4, recomendado con drizzle/postgres.js — prepare: false)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DATABASE=rappi

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Cassandra (DataStax Astra DB)
ASTRA_DB_ID=your-astra-db-id
ASTRA_DB_REGION=us-east-2
ASTRA_DB_API_ENDPOINT=https://your-db-id-your-region.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=your-astra-application-token
ASTRA_DB_KEYSPACE=db_uade

# Bootstrap inicial (cuentas + catálogo). Pedidos/métricas: flujo real de la app.
# 1. Aplicar migraciones Postgres: pnpm db:migrate
# 2. Crear tablas Cassandra desde docs/CASSANDRA_MODELO_FISICO.cql si se usa Astra
# 3. MOCK_DB=false y correr: pnpm db:seed (Postgres obligatorio; Mongo/Redis opcionales)
